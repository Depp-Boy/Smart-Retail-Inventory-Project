# Database connection string (Supabase PostgreSQL with Psycopg 3)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase API (optional for backend direct DB access)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# MongoDB Audit Logging (Atlas mongodb+srv:// or local mongodb://)
# Example Atlas: MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Example Local: MONGODB_URL="mongodb://localhost:27017"
MONGODB_URL=""
MONGODB_DB_NAME="smart_retail_audit"
MONGODB_COLLECTION_NAME="audit_logs"

# Application Environment
APP_ENV="development"
SECRET_KEY="replace_with_a_long_random_secret_key_at_least_32_characters"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings (allowed frontend origins)
FRONTEND_URL="http://localhost:5173"
